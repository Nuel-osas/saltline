{
  "name": "saltline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5280",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5281",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "format": "prettier --write \"src/**/*.{js,ts,css}\" index.html",
    "verify:testnet": "node scripts/verify-testnet.mjs",
    "e2e:testnet": "node scripts/e2e-testnet.mjs",
    "e2e:v2": "node scripts/e2e-v2.mjs",
    "verify:v2": "node --import ./agents/ts-hook.mjs scripts/v2-chain-check.mjs v2.saltline.testnet"
  },
  "devDependencies": {
    "happy-dom": "21.0.4",
    "playwright-core": "1.65.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "near-kit": "0.20.2"
  }
}
