# Copy to .env (never committed). Testnet only.
VITE_NEAR_NETWORK=testnet
VITE_CONTRACT_ID=saltline.testnet
# The v2 game (docs/GAME.md) runs on its own contract; ?game=v2 or VITE_GAME=v2 selects it.
VITE_CONTRACT_ID_V2=v2.saltline.testnet
# The faucet server's account and key (server side only: no VITE_ prefix, so it never reaches the browser).
FAUCET_ACCOUNT_ID=faucet.saltline.testnet
FAUCET_PRIVATE_KEY=
# Saltline v2's contract, for dock passes claimed with game "v2" (server side only, no default: without it a v2
# claim answers 503). The same faucet account must be the contract's faucet_id.
CONTRACT_ID_V2=
# The broker agents' keys (agents/ only).
BROKER_MOSS_KEY=
BROKER_INES_KEY=
BROKER_QM_KEY=

# Sign-in for v2 (login/, server/auth.ts). All three together switch it on; with none, players get a guest pass.
# - VITE_PRIVY_APP_ID and PRIVY_APP_ID: the Privy app's id (public; the same value twice, once for the browser).
# - WALLET_SECRET: a long random server-only secret (32+ characters) that players' testnet keys are derived from.
#   Changing it changes every player's account. Never commit it, and never give it a VITE_ prefix.
VITE_PRIVY_APP_ID=
PRIVY_APP_ID=
WALLET_SECRET=

# The database for users and metrics (docs/DATA.md). Server side only: none of these takes a VITE_ prefix. With none
# of them set nothing is kept, and the game plays exactly the same.
# - UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN: an Upstash Redis database's REST address and token. Vercel's
#   Upstash integration sets the same pair as KV_REST_API_URL and KV_REST_API_TOKEN; either pair switches it on.
# - SALTLINE_STORE: where to keep it, when the default isn't wanted. `npm run dev` keeps it in
#   .saltline.local/store.json ("file") even with the pair above in .env; "upstash" makes the dev server use the real
#   database, and "off" keeps nothing.
# - METRICS_SALT: optional, 16+ characters (openssl rand -hex 32). Device and sign-in ids are hashed with it before
#   they are counted. Without it the salt is derived from WALLET_SECRET; with neither, nothing is counted.
# - STATS_ADMIN_TOKEN: 16+ characters (openssl rand -hex 32). Whoever sends it can read GET /api/stats; without it
#   that address answers 404. Never commit it.
# - STATS_URL: for `npm run stats` on this machine only: the address to ask. Default http://127.0.0.1:5280/api/stats.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SALTLINE_STORE=
METRICS_SALT=
STATS_ADMIN_TOKEN=
STATS_URL=
