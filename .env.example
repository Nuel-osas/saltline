# Copy to .env (never committed). Testnet only.
VITE_NEAR_NETWORK=testnet
VITE_CONTRACT_ID=saltline.testnet
# The v2 game (docs/GAME.md) runs on its own contract; ?game=v2 or VITE_GAME=v2 selects it.
VITE_CONTRACT_ID_V2=v2.saltline.testnet
# The faucet server's account and key (server side only: no VITE_ prefix, so it never reaches the browser).
FAUCET_ACCOUNT_ID=faucet.saltline.testnet
FAUCET_PRIVATE_KEY=
# Saltline v2's contract, for dock passes claimed with game "v2" (server side only, no default: without it a v2
# claim answers 503). The same faucet account must be the contract's faucet_id.
CONTRACT_ID_V2=
# The broker agents' keys (agents/ only).
BROKER_MOSS_KEY=
BROKER_INES_KEY=
BROKER_QM_KEY=

# Sign-in for v2 (login/, server/auth.ts). All three together switch it on; with none, players get a guest pass.
# - VITE_PRIVY_APP_ID and PRIVY_APP_ID: the Privy app's id (public; the same value twice, once for the browser).
# - WALLET_SECRET: a long random server-only secret (32+ characters) that players' testnet keys are derived from.
#   Changing it changes every player's account. Never commit it, and never give it a VITE_ prefix.
VITE_PRIVY_APP_ID=
PRIVY_APP_ID=
WALLET_SECRET=
